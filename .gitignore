# 鸿蒙 HarmonyOS 项目 .gitignore

# ===== 鸿蒙构建输出 =====
build/
.hvigor/
*/build/

# ===== 鸿蒙依赖 =====
oh_modules/
node_modules/

# ===== 鸿蒙本地配置 =====
local.properties
*.iml

# ===== 包管理锁文件（可选，团队协作时建议提交）=====
# oh-package-lock.json5

# ===== IDE 配置 =====
# IDEA / DevEco Studio
.idea/
*.iws
*.iml
*.ipr
.DS_Store
.gradle/

# VSCode
.vscode/
*.code-workspace

# ===== 系统文件 =====
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# ===== 日志文件 =====
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ===== 临时文件 =====
*.tmp
*.temp
*.swp
*.swo
*~
.cache/

# ===== AI 生成的测试图片（保留脚本，忽略输出）=====
scripts/output/*.png
scripts/output/*.jpg
scripts/output/*.jpeg

# ===== Python 相关（AI 生图脚本）=====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
ENV/
env/

# ===== 编译产物 =====
*.hap
*.app
*.dex
*.ap_
*.class

# ===== 签名文件（敏感信息）=====
*.jks
*.keystore
*.p12
*.key
*.pem

# ===== 测试覆盖率报告 =====
coverage/
*.lcov
.nyc_output/

# ===== 其他 =====
.project
.classpath
.settings/
bin/
gen/
out/
.externalNativeBuild/
captures/
.cxx/
